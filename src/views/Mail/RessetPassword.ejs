<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office" lang="vi">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="x-apple-disable-message-reformatting" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Yêu cầu thiết lập lại mật khẩu tài khoản (Chat App)</title>
  <!--[if gte mso 9]>
  <xml>
    <o:OfficeDocumentSettings>
      <o:AllowPNG/>
      <o:PixelsPerInch>96</o:PixelsPerInch>
    </o:OfficeDocumentSettings>
  </xml>
  <![endif]-->
  <style type="text/css">
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
    
    body, table, td, a {
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }
    table, td {
      mso-table-lspace: 0pt;
      mso-table-rspace: 0pt;
    }
    img {
      -ms-interpolation-mode: bicubic;
      border: 0;
      outline: none;
      text-decoration: none;
    }
    body {
      margin: 0;
      padding: 0;
      width: 100% !important;
      min-width: 100%;
      background-color: #f1f5f9;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    .btn-hover:hover {
      background-color: #5b21b6 !important;
    }
    @media screen and (max-width: 620px) {
      .email-container {
        width: 100% !important;
        max-width: 100% !important;
      }
      .content-padding {
        padding: 24px 16px !important;
      }
      .header-badge-col {
        text-align: left !important;
        padding-top: 12px !important;
      }
      .mobile-title {
        font-size: 20px !important;
        line-height: 28px !important;
      }
      .mobile-btn {
        width: 100% !important;
        padding: 14px 12px !important;
        box-sizing: border-box;
        text-align: center !important;
      }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f1f5f9; -webkit-font-smoothing: antialiased; font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  <div style="background-color: #f1f5f9; padding: 30px 10px 40px 10px;">
    <!--[if (gte mso 9)|(IE)]>
    <table align="center" border="0" cellspacing="0" cellpadding="0" width="600">
    <tr>
    <td align="center" valign="top" width="600">
    <![endif]-->
    <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" class="email-container" style="max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); border-collapse: separate;">
      
      <!-- Top Accent Line -->
      <tr>
        <td height="5" style="background: linear-gradient(90deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%); background-color: #7c3aed; font-size: 1px; line-height: 5px;">&nbsp;</td>
      </tr>

      <!-- Main Content Card -->
      <tr>
        <td class="content-padding" style="padding: 36px 36px 32px 36px;">
          
          <!-- Header (Logo + Recovery Badge) -->
          <table border="0" cellpadding="0" cellspacing="0" width="100%">
            <tr>
              <td valign="middle" align="left">
                <table border="0" cellpadding="0" cellspacing="0">
                  <tr>
                    <td valign="middle" style="padding-right: 12px;">
                      <div style="width: 38px; height: 38px; background: linear-gradient(135deg, #6366f1 0%, #7c3aed 100%); background-color: #7c3aed; border-radius: 10px; text-align: center; line-height: 38px;">
                        <span style="font-size: 18px; color: #ffffff; line-height: 38px; font-weight: bold; display: inline-block;">🔒</span>
                      </div>
                    </td>
                    <td valign="middle">
                      <div style="font-size: 16px; font-weight: 800; color: #0f172a; letter-spacing: 0.5px; text-transform: uppercase;">CHAT APP</div>
                      <div style="font-size: 11px; color: #64748b; font-weight: 500; margin-top: 2px;">Trung tâm Bảo mật &amp; Khôi phục Tài khoản</div>
                    </td>
                  </tr>
                </table>
              </td>
              <td valign="middle" align="right" class="header-badge-col">
                <table border="0" cellpadding="0" cellspacing="0" style="display: inline-table;">
                  <tr>
                    <td style="background-color: #f3e8ff; border: 1px solid #e9d5ff; border-radius: 20px; padding: 5px 14px; text-align: center;">
                      <span style="font-size: 11px; font-weight: 700; color: #7c3aed; letter-spacing: 0.5px; text-transform: uppercase; white-space: nowrap;">KHÔI PHỤC: BƯỚC 2/3</span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>

          <!-- Hero Heading & Intro -->
          <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-top: 28px;">
            <tr>
              <td align="left">
                <h1 class="mobile-title" style="margin: 0 0 12px 0; font-size: 24px; font-weight: 800; color: #0f172a; line-height: 32px; letter-spacing: -0.5px;">
                  Yêu cầu đặt lại mật khẩu
                </h1>
                <p style="margin: 0 0 8px 0; font-size: 14px; color: #1e293b; font-weight: 700; line-height: 22px;">
                  Xin chào <%= dataEmail.fullname || dataEmail.fullName || 'bạn' %>,
                </p>
                <p style="margin: 0; font-size: 14px; color: #475569; line-height: 22px;">
                  Hệ thống đã nhận được yêu cầu cấp lại mật khẩu cho tài khoản của bạn.<br />
                  Vui lòng làm theo tiến trình xác thực dưới đây để hoàn tất việc đổi mật khẩu:
                </p>
              </td>
            </tr>
          </table>

          <!-- Stepper Progress Card -->
          <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-top: 24px; background-color: #f8fafc; border: 1px solid #edf2f7; border-radius: 12px; padding: 20px; border-collapse: separate;">
            <!-- Step 1 (Completed) -->
            <tr>
              <td width="36" valign="top" align="center" style="padding-right: 14px;">
                <table border="0" cellpadding="0" cellspacing="0">
                  <tr>
                    <td width="26" height="26" style="background-color: #10b981; border-radius: 50%; text-align: center; color: #ffffff; font-size: 13px; font-weight: 800; line-height: 26px;">
                      ✓
                    </td>
                  </tr>
                  <tr>
                    <td align="center">
                      <div style="width: 2px; height: 26px; background-color: #10b981; margin: 3px 0;"></div>
                    </td>
                  </tr>
                </table>
              </td>
              <td valign="top" style="padding-bottom: 12px;">
                <div style="font-size: 14px; font-weight: 700; color: #1e293b; line-height: 20px;">
                  Bước 1: Gửi yêu cầu quên mật khẩu
                </div>
                <div style="font-size: 12px; color: #64748b; line-height: 18px; margin-top: 2px;">
                  Yêu cầu đã được xác thực từ địa chỉ IP và email của bạn.
                </div>
              </td>
            </tr>

            <!-- Step 2 (Active) -->
            <tr>
              <td width="36" valign="top" align="center" style="padding-right: 14px;">
                <table border="0" cellpadding="0" cellspacing="0">
                  <tr>
                    <td width="26" height="26" style="background-color: #7c3aed; border-radius: 50%; text-align: center; color: #ffffff; font-size: 13px; font-weight: 800; line-height: 26px;">
                      2
                    </td>
                  </tr>
                  <tr>
                    <td align="center">
                      <div style="width: 2px; height: 26px; background-color: #cbd5e1; margin: 3px 0;"></div>
                    </td>
                  </tr>
                </table>
              </td>
              <td valign="top" style="padding-bottom: 12px;">
                <div style="font-size: 14px; font-weight: 700; color: #7c3aed; line-height: 20px;">
                  Bước 2: Xác nhận liên kết cấp lại mật khẩu (Đang chờ bạn)
                </div>
                <div style="font-size: 12px; color: #64748b; line-height: 18px; margin-top: 2px;">
                  Bấm vào nút xác thực bên dưới để mở giao diện nhập mật khẩu mới.
                </div>
              </td>
            </tr>

            <!-- Step 3 (Pending) -->
            <tr>
              <td width="36" valign="top" align="center" style="padding-right: 14px;">
                <table border="0" cellpadding="0" cellspacing="0">
                  <tr>
                    <td width="24" height="24" style="background-color: #ffffff; border: 2px solid #cbd5e1; border-radius: 50%; text-align: center; color: #94a3b8; font-size: 12px; font-weight: 700; line-height: 24px;">
                      3
                    </td>
                  </tr>
                </table>
              </td>
              <td valign="top">
                <div style="font-size: 14px; font-weight: 600; color: #94a3b8; line-height: 20px;">
                  Bước 3: Tạo mật khẩu mới &amp; Đăng nhập trở lại
                </div>
                <div style="font-size: 12px; color: #94a3b8; line-height: 18px; margin-top: 2px;">
                  Phiên làm việc sẽ được cập nhật và bảo vệ an toàn.
                </div>
              </td>
            </tr>
          </table>

          <!-- CTA Button Section -->
          <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-top: 32px;">
            <tr>
              <td align="center">
                <!--[if mso]>
                <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="<%= dataEmail.link %>" style="height:48px;v-text-anchor:middle;width:300px;" arcsize="18%" stroke="f" fillcolor="#6d28d9">
                <w:anchorlock/>
                <center style="color:#ffffff;font-family:'Plus Jakarta Sans',sans-serif;font-size:14px;font-weight:bold;letter-spacing:0.5px;">ĐẶT LẠI MẬT KHẨU NGAY &rarr;</center>
                </v:roundrect>
                <![endif]-->
                <!--[if !mso]><!-- -->
                <a href="<%= dataEmail.link %>" target="_blank" class="mobile-btn btn-hover" style="background: linear-gradient(135deg, #6366f1 0%, #7c3aed 100%); background-color: #6d28d9; color: #ffffff; text-decoration: none; display: inline-block; padding: 15px 36px; border-radius: 10px; font-size: 14px; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; box-shadow: 0 6px 18px rgba(109, 40, 217, 0.35); mso-padding-alt: 0;">
                  ĐẶT LẠI MẬT KHẨU NGAY &nbsp;&rarr;
                </a>
                <!--<![endif]-->
                <div style="margin-top: 10px; font-size: 12px; color: #64748b;">
                  ⚡ Chỉ mất 1 phút &bull; Mã hóa bảo mật cao
                </div>
              </td>
            </tr>
          </table>

          <!-- Important Security Notice (Amber/Yellow Card) -->
          <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-top: 28px; background-color: #fffbeb; border: 1px solid #fef3c7; border-radius: 12px; padding: 18px 20px; border-collapse: separate;">
            <tr>
              <td>
                <div style="font-size: 13px; font-weight: 800; color: #92400e; letter-spacing: 0.3px; text-transform: uppercase; margin-bottom: 8px;">
                  🔒 LƯU Ý QUAN TRỌNG VỀ BẢO MẬT TÀI KHOẢN:
                </div>
                <div style="font-size: 13px; color: #78350f; line-height: 22px;">
                  <div style="margin-bottom: 4px;">&bull; Đường liên kết đặt lại mật khẩu có thời hạn trong vòng <strong>15 phút</strong>.</div>
                  <div style="margin-bottom: 4px;">&bull; Sau khi đổi mật khẩu, toàn bộ phiên đăng nhập cũ trên các thiết bị khác sẽ bị thu hồi.</div>
                  <div>&bull; Nhân viên Chat App không bao giờ chủ động yêu cầu bạn cung cấp mật khẩu.</div>
                </div>
              </td>
            </tr>
          </table>

          <!-- Fallback Link Section -->
          <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-top: 28px; border-top: 1px solid #f1f5f9; padding-top: 22px;">
            <tr>
              <td align="left">
                <p style="margin: 0 0 10px 0; font-size: 13px; color: #64748b; line-height: 20px;">
                  Nếu nút bấm phía trên không hoạt động, hãy copy đường dẫn này dán vào trình duyệt:
                </p>
                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    <td style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 14px; word-break: break-all;">
                      <a href="<%= dataEmail.link %>" target="_blank" style="color: #6366f1; font-size: 12px; text-decoration: underline; font-family: 'Consolas', 'Courier New', monospace; word-break: break-all;">
                        <%= dataEmail.link %>
                      </a>
                    </td>
                  </tr>
                </table>
                <p style="margin: 14px 0 0 0; font-size: 12px; color: #dc2626; font-weight: 500; line-height: 18px;">
                  &Delta; Nếu bạn KHÔNG yêu cầu đặt lại mật khẩu, xin hãy bỏ qua email này hoặc liên hệ hỗ trợ ngay.
                </p>
              </td>
            </tr>
          </table>

        </td>
      </tr>
    </table>
    <!--[if (gte mso 9)|(IE)]>
    </td>
    </tr>
    </table>
    <![endif]-->

    <!-- Footer -->
    <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; margin: 24px auto 0 auto;">
      <tr>
        <td align="center" style="font-size: 12px; color: #94a3b8; line-height: 18px; text-align: center;">
          &copy; 2026 Chat App Platform Inc. &bull; Bảo mật tài khoản &bull; nguyentruongphuc.25022004@gmail.com
        </td>
      </tr>
    </table>

  </div>
</body>
</html>
